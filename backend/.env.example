# 複製這個檔案成 .env，填入真正的值。.env 已在 .gitignore 排除，不會進版控。
#
# ⚠️ 如果你是從 api/GPS_app.py、api/BUS_app.py 的舊原型搬過來的金鑰，
# 那兩把金鑰（Google Maps API Key、TDX Client Secret）先前是明碼寫在
# 原始碼裡的，等同已經外洩 —— 填進這裡之前，請先去 Google Cloud Console
# 與 TDX 會員中心撤銷重發，不要沿用舊值。

# Google Routes API（公車路線規劃，/bus-plans 用）
GOOGLE_MAPS_API_KEY=

# TDX 運輸資料流通服務（到站時間，/eta 用）
TDX_CLIENT_ID=
TDX_CLIENT_SECRET=

# Google Cloud Vision 服務帳戶金鑰的路徑（公車車頭 OCR，/bus-ocr 用）
# 建議放在 backend/credentials/ 底下（該資料夾已在 .gitignore 排除）
GOOGLE_APPLICATION_CREDENTIALS=./credentials/blind-glasses-ocr-service-account.json

# 公車 LED 偵測的 YOLO 權重路徑（選填，預設 backend/models/best.pt）
# BUS_OCR_MODEL_PATH=./models/best.pt

# LLM 意圖解析（/route，對應 ai-agent/RemoteLlmIntentGateway.kt 的協定）
OPENAI_API_KEY=
# 選填，預設 gpt-4o-mini——導盲場景下「快速回覆」比「更聰明」重要
# OPENAI_MODEL=gpt-4o-mini
