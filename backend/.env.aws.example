# AWS Lambda 版的設定。複製成 .env.aws 並填入真正的值（.env.aws 已在 .gitignore 排除）。
# deploy/aws/deploy.py 會把這些設成 Lambda 的環境變數；不會把值印到畫面上。
#
# 格式跟 .env 一樣。外部 API 的金鑰可以沿用 .env 的，共用金鑰建議另外產生一把，
# 讓 Cloudflare 版與 AWS 版互不影響（其中一邊外洩，另一邊不受牽連）。

# ===== 必填：共用金鑰 =====
# 眼鏡與手機呼叫 AWS 後端時帶的 X-Api-Key。沒填的話 deploy.py 會拒絕部署。
# 產生一把：python -c "import secrets; print(secrets.token_urlsafe(32))"
# 同一把要填進 apps/local.properties 的 guideglasses.aws.apiKey。
GUIDEGLASSES_API_KEY=

# Google Routes API（公車路線規劃、步行路線）
GOOGLE_MAPS_API_KEY=

# TDX 運輸資料流通服務（到站時間）
TDX_CLIENT_ID=
TDX_CLIENT_SECRET=

# Google Cloud Vision 服務帳戶金鑰的「檔案路徑」（確認公車）。
# Lambda 上沒有這個檔案：deploy.py 會讀出內容、壓成一行放進環境變數，後端啟動時再寫回 /tmp。
# 相對路徑一律相對於 backend/。
GOOGLE_APPLICATION_CREDENTIALS=./credentials/blind-glasses-ocr-service-account.json

# LLM 意圖解析與聊天
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# 不需要設定 LOCATION_TABLE：deploy.py 會自動填入它建立的 DynamoDB 表名。
