<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 網路 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- 感測 -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!--
        前景服務。

        眼鏡上實測 App 退到背景 2.4 秒就被系統回收（adj 900 cached），
        而導盲的使用情境本來就是螢幕關著的 —— 沒有前景服務，
        這套系統在真實情境下等於不存在。細節見 GuideGlassesForegroundService。

        CAMERA / MICROPHONE 兩個細分權限是 Android 14 起的要求；
        眼鏡是 Android 12 用不到，但 targetSdk 是 36，裝到新機器上就需要。
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 眼鏡連線（CXR-M SDK 需求：藍牙 + 定位）-->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES" />

    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <!--
        開發工具（人臉註冊伺服器、InsightFace 後端）都是區網上的 HTTP 服務，
        而 targetSdk 28 以上預設封鎖明文流量 —— 不開這個，「同步人臉」會直接
        連不出去，而且錯誤看起來像是位址設錯。

        只在 debug build 開放（見 app/build.gradle.kts 的 manifestPlaceholders），
        release 維持禁止，正式流量一律走 HTTPS。
    -->
    <application
        android:name=".GuideGlassesApplication"
        android:usesCleartextTraffic="${cleartextTraffic}"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.GuideGlasses">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            型別在執行期還會依「當下實際拿到哪些權限」再算一次
            （見 GuideGlassesForegroundService.currentServiceType）——
            Android 14 起宣告 camera 型別卻沒有 CAMERA 執行期權限會直接
            丟 SecurityException，而語音播報本來就不需要相機。
        -->
        <service
            android:name=".GuideGlassesForegroundService"
            android:exported="false"
            android:foregroundServiceType="camera|microphone" />
    </application>

</manifest>
