<?xml version="1.0" encoding="utf-8"?>
<!--
    整片畫面就是對話記錄。

    原本有「說話」與「停止播報」兩個按鈕。語音指令改成常駐監聽之後，
    按鈕就沒有存在的理由了 —— 使用者戴著眼鏡，本來就不會去點螢幕；
    停止也改用語音（「停止播報」「不要說了」）。

    畫面留給唯一有用的東西：**它聽到了什麼、回了什麼**。
    真正的使用者靠聽覺，這塊是給開發者與陪同者判斷
    「沒聽到 / 聽錯了 / 聽對了但慢」用的。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="8dp">

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#222222"
        android:gravity="center"
        android:paddingVertical="6dp"
        android:text="@string/status_idle"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold" />

    <!--
        眼鏡螢幕只有 480×398，字級是在「看得到幾行」與「看得清楚」
        之間取的折衷。
    -->
    <ScrollView
        android:id="@+id/scrollLog"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="4dp"
        android:background="#111111"
        android:fillViewport="true">

        <TextView
            android:id="@+id/tvLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:contentDescription="@string/desc_transcript"
            android:lineSpacingExtra="2dp"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />
    </ScrollView>

</LinearLayout>
